DATABASE_URL=postgresql://user:password@host:port/cinema_users

JWT_SECRET=
JWT_ALGORITHM=HS256

REDIS_URL=redis://user:password@host:port

DEBUG=false

# auth-service URL
# Local (Docker):      http://auth-service:8005
# Producción (Render): auth-service-cinema.onrender.com
AUTH_SERVICE_URL=

# booking-service URL — para GET /me/purchases (ya no lee cinema_booking directo)
# Local (Docker):      http://booking-service:8004
# Producción (Render): booking-service-cinema-<sufijo>.onrender.com
BOOKING_SERVICE_URL=

# Debe coincidir con INTERNAL_SERVICE_TOKEN en booking-service-cinema y admin-service-cinema
INTERNAL_SERVICE_TOKEN=

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

PYTHON_VERSION=3.12
